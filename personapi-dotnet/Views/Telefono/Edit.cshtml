@model personapi_dotnet.Models.ViewModels.TelefonoViewModel

@{
    ViewData["Title"] = "Editar teléfono";
}

<h1>Editar teléfono</h1>

<h4>Telefono</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* La llave primaria no se edita: se muestra y viaja oculta. *@
            <input type="hidden" asp-for="Num" />
            <div class="form-group">
                <label asp-for="Num" class="control-label"></label>
                <input class="form-control" value="@Model.Num" disabled />
            </div>

            <div class="form-group">
                <label asp-for="Oper" class="control-label"></label>
                <input asp-for="Oper" class="form-control" />
                <span asp-validation-for="Oper" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Duenio" class="control-label"></label>
                <select asp-for="Duenio" asp-items="Model.Personas" class="form-control">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="Duenio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}