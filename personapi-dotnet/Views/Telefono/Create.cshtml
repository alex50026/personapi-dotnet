@model personapi_dotnet.Models.Entities.Telefono

@{
    ViewData["Title"] = "Crear teléfono";
}

<h1>Crear teléfono</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Num" class="control-label"></label>
                <input asp-for="Num" class="form-control" />
                <span asp-validation-for="Num" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Oper" class="control-label"></label>
                <input asp-for="Oper" class="form-control" />
                <span asp-validation-for="Oper" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Duenio" class="control-label"></label>
                <input asp-for="Duenio" class="form-control" />
                <span asp-validation-for="Duenio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}