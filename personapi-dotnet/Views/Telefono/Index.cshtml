@model IEnumerable<personapi_dotnet.Models.Entities.Telefono>

@{
    ViewData["Title"] = "Teléfonos";
}

<h1>Teléfonos</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Num)</th>
            <th>@Html.DisplayNameFor(model => model.Oper)</th>
            <th>Cédula del dueño</th>
            <th>Nombre del dueño</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Num</td>
                <td>@item.Oper</td>
                <td>@item.Duenio</td>
                <td>@item.DuenioNavigation?.Nombre @item.DuenioNavigation?.Apellido</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Num">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Num">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Num">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>