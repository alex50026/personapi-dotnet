@model personapi_dotnet.Models.ViewModels.EstudioViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Estudio</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.CcPer" asp-route-idprof="@Model.IdProf">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* La llave compuesta no se edita: se muestra y viaja oculta. *@
            <input type="hidden" asp-for="CcPer" />
            <input type="hidden" asp-for="IdProf" />
            <div class="form-group">
                <label asp-for="CcPer" class="control-label"></label>
                <input class="form-control" value="@Model.CcPer" disabled />
            </div>
            <div class="form-group">
                <label asp-for="IdProf" class="control-label"></label>
                <input class="form-control" value="@Model.IdProf" disabled />
            </div>
            <div class="form-group">
                <label asp-for="Fecha" class="control-label"></label>
                <input asp-for="Fecha" type="date" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Univer" class="control-label"></label>
                <input asp-for="Univer" class="form-control" />
                <span asp-validation-for="Univer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
