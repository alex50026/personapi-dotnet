# Copie este archivo como ".env" (en la misma carpeta que docker-compose.yml)
# y cambie la contraseña. ".env" está en .gitignore: NO se sube al repositorio.
#
# Política de SQL Server: mínimo 8 caracteres con 3 de estos 4 tipos:
# mayúsculas, minúsculas, números y símbolos.
# No use ; ni $ (rompen la cadena de conexión o la interpolación de Compose).
SA_PASSWORD=CambieEsta_Clave2026!
